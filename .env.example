# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Individual Fields)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=car_wash_db

# Or Database Connection String
DATABASE_URL=postgres://postgres:postgres@localhost:5432/car_wash_db

# Security
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=24h

# Settings
OVERTIME_WEEKLY_THRESHOLD=44
OVERTIME_RATE_MULTIPLIER=1.5
